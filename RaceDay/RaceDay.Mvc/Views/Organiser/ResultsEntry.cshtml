@model RaceDay.Mvc.Models.ResultViewModel

@{
    ViewData["Title"] = "Enter Results";
}

<div class="container mt-4">
    <h2>Record Participant Result</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="ResultsEntry" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="EnrollmentID" class="form-label">Enrolment ID</label>
            <input asp-for="EnrollmentID" type="number" min="1"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">Finish Time</label>
            <input asp-for="FinishTime" type="time" step="1"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">Finishing Position</label>
            <input asp-for="Position" type="number" min="1"
                   class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Save Result</button>
        <a asp-action="Results" class="btn btn-secondary">Cancel</a>
    </form>
</div>