@{
    ViewData["Title"] = "Organiser Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid py-4">

    <!-- Dashboard heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Organiser Dashboard</h1>
            <p class="text-muted mb-0">
                Welcome back, @Context.Session.GetString("UserName").
                Manage your RaceDay events from here.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    <!-- Dashboard statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Events</p>
                    <h2 class="fw-bold">--</h2>
                    <small class="text-muted">
                        Events created by you
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Enrolments</p>
                    <h2 class="fw-bold">--</h2>
                    <small class="text-muted">
                        Participants across your events
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Upcoming Events</p>
                    <h2 class="fw-bold">--</h2>
                    <small class="text-muted">
                        Events scheduled for the future
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- Management navigation -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h4 class="fw-bold mb-3">Event Management</h4>

            <div class="row g-3">

                <div class="col-md-4">
                    <a asp-controller="Organiser"
                       asp-action="Events"
                       class="btn btn-outline-primary w-100 py-3">
                        Manage Events
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Organiser"
                       asp-action="Categories"
                       class="btn btn-outline-primary w-100 py-3">
                        Manage Categories
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Organiser"
                       asp-action="Enrolments"
                       class="btn btn-outline-primary w-100 py-3">
                        View Enrolments
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Organiser"
                       asp-action="Results"
                       class="btn btn-outline-primary w-100 py-3">
                        Enter Results
                    </a>
                </div>

            </div>
        </div>
    </div>

    <!-- Upcoming events -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h4 class="fw-bold mb-3">Upcoming Events</h4>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Enrolments</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="4"
                                class="text-center text-muted py-4">
                                Event information will appear here
                                once connected to the API.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
