@model List<RaceDay.Mvc.Models.RaceEventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Events</h2>
            <p class="text-muted">View and manage RaceDay events.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events have been created yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(item.BannerUrl))
                        {
                            <img src="@item.BannerUrl"
                                 class="card-img-top"
                                 alt="@item.EventName banner"
                                 style="height:190px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:190px;">
                                <span class="text-muted">
                                    No event banner
                                </span>
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p class="card-text text-muted">
                                @item.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @item.DistanceKm km
                            </p>

                            <p>
                                <strong>Type:</strong>
                                @item.EventType
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0 p-3">
                            <div class="d-flex gap-2">

                                <a asp-controller="Organiser"
                                   asp-action="EditEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-primary flex-fill">
                                    Edit
                                </a>

                                <form asp-controller="Organiser"
                                      asp-action="DeleteEvent"
                                      asp-route-id="@item.EventID"
                                      method="post"
                                      class="flex-fill"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">
                                        Delete
                                    </button>
                                </form>

                            </div>
                        </div>

                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

</div>
