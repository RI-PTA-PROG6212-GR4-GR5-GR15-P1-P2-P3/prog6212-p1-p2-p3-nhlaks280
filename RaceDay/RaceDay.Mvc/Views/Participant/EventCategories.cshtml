@model List<RaceDay.Mvc.Models.EventCategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Available Event Categories</h1>
        <p class="text-muted">
            Choose the category you want to participate in.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-primary mb-3">
                                Category
                            </span>

                            <h4 class="card-title">
                                @(item.Category?.CategoryName ?? "Unnamed Category")
                            </h4>

                            <p class="card-text text-muted">
                                @(item.Category?.Description ?? "No description available.")
                            </p>

                            <p>
                                <strong>Event ID:</strong> @item.EventID
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Enrol"
                               asp-route-id="@item.EventCategoryID"
                               class="btn btn-primary w-100">
                                Enrol in this category
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No categories are currently available for this event.
        </div>
    }

    <div class="mt-4"> 
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

</div>
