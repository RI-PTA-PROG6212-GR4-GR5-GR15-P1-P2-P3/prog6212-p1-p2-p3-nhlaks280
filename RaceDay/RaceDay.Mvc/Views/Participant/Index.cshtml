@model List<RaceDay.Mvc.Models.ParticipantEventCategoryViewModel>

@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Available RaceDay Events</h2>
            <p class="text-muted">Browse events and select your preferred category.</p>
        </div>

        <div>
            <a asp-action="MyEnrolments" class="btn btn-primary">
                My Enrolments
            </a>

            <a asp-action="Results" class="btn btn-outline-primary">
                My Results
            </a>

            <a asp-action="Profile" class="btn btn-outline-secondary">
                My Profile
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No event categories are currently available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5>@(item.Event?.EventName ?? "Event")</h5>

                            <p>@(item.Event?.Description ?? "No description available.")</p>

                            <hr />

                            <p><strong>Category:</strong> @(item.Category?.CategoryName ?? "Unknown")</p>
                            <p><strong>Date:</strong> @(item.Event?.EventDate.ToString("dd MMM yyyy") ?? "Not specified")</p>
                            <p><strong>Location:</strong> @(item.Event?.Location ?? "Not specified")</p>
                            <p><strong>Distance:</strong> @(item.Event?.DistanceKm.ToString("0.##") ?? "0") km</p>
                            <p><strong>Type:</strong> @(item.Event?.EventType ?? "Not specified")</p>

                            <form asp-action="Enrol" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="EventCategoryID"
                                       value="@item.EventCategoryID" />

                                <button type="submit" class="btn btn-success w-100">
                                    Enrol Now
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>