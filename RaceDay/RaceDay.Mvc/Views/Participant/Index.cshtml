@model List<RaceDay.Mvc.Models.RaceEventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container py-4">
    <h1 class="mb-2">Discover Race Events</h1>
    <p class="text-muted">Find an event and choose a category to participate.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning">@ViewBag.ErrorMessage</div>
    }

    <div class="row g-4 mt-2">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-primary">@item.EventType</span>
                        <h4 class="mt-3">@item.EventName</h4>
                        <p class="text-muted">@item.Description</p>
                        <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                        <p><strong>Location:</strong> @item.Location</p>
                        <p><strong>Distance:</strong> @item.DistanceKm km</p>
                        <a asp-action="EventCategories"
                           asp-route-id="@item.EventID"
                           class="btn btn-primary">
                            View categories
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            No events are currently available.
        </div>
    }

    <a asp-action="MyEnrollments" class="btn btn-outline-dark mt-4">
        My enrolments
    </a>
</div>