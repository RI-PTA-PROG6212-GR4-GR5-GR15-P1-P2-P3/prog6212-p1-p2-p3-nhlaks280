@{
    ViewData["Title"] = "My Profile";

    var profilePicture = Context.Session.GetString("ProfilePictureUrl");
}

<div class="container py-4">
    <h2 class="mb-4">My Profile</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm p-4">
        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(profilePicture))
            {
                <img src="@profilePicture"
                     alt="Profile picture"
                     class="rounded-circle mb-3"
                     style="width:140px;height:140px;object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:140px;height:140px;">
                    <span class="text-muted">No picture</span>
                </div>
            }

            <h4>@Context.Session.GetString("UserName")</h4>
            <p class="text-muted">
                @Context.Session.GetString("UserEmail")
            </p>
        </div>

        <hr />

        <h5>Upload Profile Picture</h5>

        <form asp-controller="Participant"
              asp-action="UploadProfilePicture"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="file" class="form-label">
                    Choose an image
                </label>

                <input type="file"
                       name="file"
                       id="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                Upload Picture
            </button>
        </form>
    </div>
</div>
