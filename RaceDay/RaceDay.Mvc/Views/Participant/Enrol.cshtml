@model RaceDay.Mvc.Models.EnrollmentCreateViewModel

@{
    ViewData["Title"] = "Confirm Enrolment";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="fw-bold mb-3">
                        Confirm Your Enrolment
                    </h2>

                    <p class="text-muted">
                        You are about to register for this event category.
                        Please confirm your enrolment below.
                    </p>

                    <div class="alert alert-info">
                        <strong>Event Category ID:</strong>
                        @Model.EventCategoryID
                    </div>

                    <form asp-controller="Participant"
                          asp-action="Enrol"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="EventCategoryID" type="hidden" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Confirm Enrolment
                        </button>

                        <a asp-controller="Participant"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
