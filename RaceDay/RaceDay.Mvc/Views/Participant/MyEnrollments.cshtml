@model List<RaceDay.Mvc.Models.EnrollmentResponseViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Enrolments</h1>
            <p class="text-muted">
                View the events you have registered for.
            </p>
        </div>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Event Name</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EnrollmentID</td>

                                    <td>
                                        @(item.EventCategory?.Event?.EventName
                                                                        ?? "Event information unavailable")
                                                                                                       </td>

                                    <td>
                                        @(item.EventCategory?.Category?.CategoryName
                                                                        ?? "Category information unavailable")
                            </td>

                                    <td>
                                        @item.EnrollmentDate.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                                                }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h5>No Enrolments Found</h5>
            <p class="mb-0">
                You have not registered for any events yet.
            </p>
        </div>
    }

</div>
