          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RaceEvent": {
        "required": [
          "eventName",
          "eventType",
          "location"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "organiserID": {
            "type": "integer",
            "format": "int32"
          },
          "eventName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "organiser": {
            "$ref": "#/components/schemas/AppUser"
          },
          "eventCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategory"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
