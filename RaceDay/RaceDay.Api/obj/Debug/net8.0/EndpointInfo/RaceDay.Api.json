            "type": "integer",
            "format": "int32"
          },
          "enrollmentID": {
            "type": "integer",
            "format": "int32"
          },
          "finishTime": {
            "type": "string",
            "format": "date-span"
          },
          "position": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "enrollment": {
            "$ref": "#/components/schemas/Enrollment"
          }
        },
        "additionalProperties": false
      },
